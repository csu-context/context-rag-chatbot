# =================================================================
# Context RAG 프로젝트 환경 변수 템플릿
# 이 파일을 '.env'로 복사한 후 실제 값을 입력하여 사용하세요.
# =================================================================

# 1. LLM 및 임베딩 모델 설정
# MODEL_TYPE: gemini, claude, ollama (기본값: ollama)
MODEL_TYPE=ollama
MODEL_NAME=gemma2:2b
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# 로컬 실행 시: http://localhost:11434
# Docker 실행 시: http://ollama:11434 (docker-compose.yml에서 자동 설정됨)
# Apple Silicon Mac 등의 로컬 가속 환경에서 호스트의 Native Ollama를 사용할 때: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# 2. 평가(Evaluation) 및 데이터셋 생성 설정
# 추론용 모델과 별도로 평가 판사 및 데이터 생성 모델을 지정할 수 있습니다.
EVAL_MAX_SAMPLES=50

# 평가 판사 (선생님) 설정
EVAL_JUDGE_TYPE=claude
EVAL_JUDGE_MODEL=claude-haiku-4-5-20251001

# 평가 데이터셋 생성 (문제 출제자) 설정
EVAL_DATA_GEN_TYPE=claude
EVAL_DATA_GEN_MODEL=claude-haiku-4-5

# 3. 파이프라인 및 검색(Retriever) 설정
# PARSER_TYPE: manual (빠름), docling (표 분석 및 한글 OCR 최적화, 권장)
PARSER_TYPE=docling
# RETRIEVER_TYPE: vector, hybrid (BM25 + Vector)
RETRIEVER_TYPE=hybrid
# RERANKER_TYPE: local, cohere, jina
RERANKER_TYPE=local
# ALLOW_EXTERNAL_RERANKER: 보안 정책에 따른 외부 API 리랭커 허용 여부 (true/false)
ALLOW_EXTERNAL_RERANKER=false

# 앙상블 리트리버 RRF 가중치 설정 (#46)
RRF_K=60
HYBRID_WEIGHT_BM25=0.5
HYBRID_WEIGHT_VECTOR=0.5

# 3. API 키 설정 (Google AI Studio & Anthropic)
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 4. 로컬 경로 및 DB 설정
DATA_PATH=./data
DB_PATH=./vector_db

# 5. ChromaDB 서버 모드 설정 (Docker-Compose 사용 시)
# CHROMA_SERVER_HOST=chromadb
# CHROMA_SERVER_PORT=8000

# 5-1. Redis 세션 스토어 (Issue 12: 수평 확장 / Stateless 아키텍처)
# Docker Compose 사용 시: REDIS_URL=redis://redis:6379/0
# 로컬 Redis 사용 시: REDIS_URL=redis://localhost:6379/0
# 미설정 시 기존 in-memory Streamlit 세션 동작 유지
# REDIS_URL=redis://redis:6379/0
# REDIS_SESSION_TTL_SEC=86400

# 6. LangChain Tracing (선택사항)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langchain_api_key_here
# LANGCHAIN_PROJECT=context-rag-chatbot
