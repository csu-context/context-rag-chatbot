# =================================================================
# Context RAG 프로젝트 환경 변수 템플릿
# 이 파일을 '.env'로 복사한 후 실제 값을 입력하여 사용하세요.
# =================================================================

# 1. LLM 및 임베딩 모델 설정
MODEL_TYPE=gemini
MODEL_NAME=gemini-flash-latest
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# 2. 파이프라인 및 검색(Retriever) 설정
# PARSER_TYPE: manual (빠름), enhanced (표 분석 포함, 정밀)
PARSER_TYPE=enhanced
# RETRIEVER_TYPE: vector, hybrid (BM25 + Vector)
RETRIEVER_TYPE=hybrid

# 3. API 키 설정 (Google AI Studio)
GOOGLE_API_KEY=your_google_api_key_here

# 4. 로컬 경로 및 DB 설정
DATA_PATH=./data
DB_PATH=./vector_db

# 5. ChromaDB 서버 모드 설정 (Docker-Compose 사용 시)
# CHROMA_SERVER_HOST=chromadb
# CHROMA_SERVER_PORT=8000

# 6. LangChain Tracing (선택사항)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langchain_api_key_here
# LANGCHAIN_PROJECT=context-rag-chatbot
