# =================================================================
# Context RAG 프로젝트 환경 변수 템플릿
# 이 파일을 '.env'로 복사한 후 실제 값을 입력하여 사용하세요.
# 주의: .env 파일은 절대 Git에 업로드하지 마세요!
# =================================================================

# 1. OpenAI 설정 (GPT-4o 사용)
OPENAI_API_KEY=your_openai_api_key_here

# 2. LangChain 설정 (디버깅 및 모니터링용 - 선택사항)
# LangSmith 계정이 있다면 아래 주석을 해제하고 키를 입력하세요.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langchain_api_key_here
# LANGCHAIN_PROJECT=context-rag-chatbot

# 3. 로컬 경로 설정 (Pathlib에서 활용됨)
# 기본적으로 프로젝트 루트 기준 상대 경로를 사용합니다.
DATA_PATH=./data
DB_PATH=./database

# 4. 임베딩 모델 설정 (로컬 BGE-M3-ko 사용 시)
# 모델 경로가 별도로 있다면 지정하세요.
EMBEDDING_MODEL_NAME=BAAI/bge-m3