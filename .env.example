# =================================================================
# Context RAG 프로젝트 환경 변수 템플릿 (Gemini 버전)
# 이 파일을 '.env'로 복사한 후 실제 값을 입력하여 사용하세요.
# =================================================================
# 주의: .env 파일은 절대 Git에 업로드하지 마세요!
# =================================================================

# 1. Gemini 설정
# Google AI Studio(https://aistudio.google.com/)에서 발급받은 키를 입력하세요.
GOOGLE_API_KEY=your_google_api_key_here

# 2. LangChain 설정 (선택사항)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langchain_api_key_here
# LANGCHAIN_PROJECT=context-rag-chatbot

# 3. 로컬 경로 및 데이터베이스 설정
DATA_PATH=./data
DB_PATH=./vector_db

# ChromaDB 서버 설정 (선택사항)
# Docker-Compose 환경에서는 자동으로 'chromadb' 컨테이너로 연결되도록 구성되어 있습니다.
# 로컬 개발 시 서버 모드로 연결하려면 아래 주석을 해제하고 호스트 주소를 입력하세요.
# CHROMA_SERVER_HOST=localhost
# CHROMA_SERVER_PORT=8000

# 4. 임베딩 모델 설정
# 로컬에서 실행할 BGE-M3 모델명을 지정합니다.
EMBEDDING_MODEL_NAME=BAAI/bge-m3